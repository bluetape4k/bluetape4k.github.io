---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { readFileSync } from 'node:fs';
import path from 'node:path';
import { pathToFileURL } from 'node:url';
import { validateVersionCatalog } from '../../scripts/manual/lib/catalog.mjs';
import { loadRepositoryRegistry, repositoryBySlug } from '../../scripts/manual/lib/repositories.mjs';
import { resolveBlogTaxonomy } from '../lib/blogTaxonomy.mjs';
import { resolveWave1ManualCompanion } from '../data/visual-companions/wave1-manual-links.mjs';
import '../styles/manual.css';

const manualRepositories = loadRepositoryRegistry(pathToFileURL(path.join(process.cwd(), 'src/data/manual/repositories.json')));
type ManualRepository = {
  slug: string;
  repository: string;
  label: Record<'en' | 'ko', string>;
};

const { starlightRoute } = Astro.locals;
const manual = starlightRoute.entry.data.manual;
const locale = starlightRoute.lang === 'ko' ? 'ko' : 'en';
const entryId = starlightRoute.entry.id;
const isBlogPost =
  (entryId.startsWith('blog/') || entryId.startsWith('ko/blog/')) &&
  entryId !== 'blog/index' &&
  entryId !== 'ko/blog/index' &&
  Boolean(starlightRoute.entry.data.blog);
const blogBasePath = locale === 'ko' ? '/ko/blog/' : '/blog/';
const blogSlug = entryId.split('/').pop() ?? '';
const blog = starlightRoute.entry.data.blog;
const blogTaxonomy = isBlogPost
  ? resolveBlogTaxonomy(
      {
        slug: blogSlug,
        title: starlightRoute.entry.data.title,
        description: blog?.cardDescription ?? starlightRoute.entry.data.description ?? '',
        tags: blog?.tags,
      },
      locale,
    )
  : undefined;
const filterHref = (kind: 'tag', value: string) =>
  `${blogBasePath}?${new URLSearchParams({ [kind]: value }).toString()}`;
let repository: ManualRepository | undefined;
try { if (manual?.repository) repository = repositoryBySlug(manualRepositories, manual.repository); } catch { /* malformed metadata renders no provenance */ }
let latestMinor;
try {
  if (repository) {
    const bytes = readFileSync(
      path.join(process.cwd(), `src/data/manual/${repository.slug}.versions.json`),
      'utf8',
    );
    latestMinor = validateVersionCatalog(JSON.parse(bytes), repository).latest;
  }
} catch (error) {
  if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;
}
const localizedId = locale === 'ko' ? starlightRoute.entry.id.replace(/^ko\//, '') : starlightRoute.entry.id;
const routeRepository = localizedId.replace(/\/$/, '').split('/')[1];
const routeMatches = routeRepository === repository?.slug;
const archived = Boolean(routeMatches && manual?.minorVersion && latestMinor && manual.minorVersion !== latestMinor);
const releaseUrl = routeMatches && manual?.releaseRef
  ? `https://github.com/${repository?.repository}/releases/tag/${encodeURIComponent(manual.releaseRef)}`
  : undefined;
const stateText = archived
  ? (locale === 'ko' ? '보존 버전' : 'Archived')
  : (locale === 'ko' ? '최신 안정판' : 'Latest stable');
const repositoryName = repository?.label.en.replace(/ docs$/, '');
const releaseLabel = locale === 'ko'
  ? `${repositoryName} ${manual?.releaseRef} 릴리스 기준`
  : `Based on ${repositoryName} release ${manual?.releaseRef}`;
const visualCompanion = manual ? resolveWave1ManualCompanion(entryId, locale) : undefined;
---

<DefaultPageTitle />
{blogTaxonomy && (
  <nav class="bt4k-page-taxonomy" aria-label={locale === 'ko' ? '블로그 글 태그' : 'Blog post tags'}>
    {blogTaxonomy.tags.map((tag) => (
      <a href={filterHref('tag', tag.slug)} data-blog-filter="tag" data-filter-value={tag.slug}>
        {tag.label}
      </a>
    ))}
  </nav>
)}
{repository && manual?.minorVersion && releaseUrl && (
  <p class="bt4k-manual-provenance" aria-label={locale === 'ko' ? '매뉴얼 배포 기준' : 'Manual release provenance'}>
    <span class="bt4k-manual-provenance__state">{stateText}</span>
    <span aria-hidden="true">·</span>
    <a href={releaseUrl}>{releaseLabel}</a>
  </p>
)}
{visualCompanion && (
  <a class="bt4k-manual-visual" href={visualCompanion.route} aria-label={`${visualCompanion.label}: ${visualCompanion.title}`}>
    <img src={visualCompanion.image} alt="" loading="eager" decoding="async" />
    <span>
      <strong>{visualCompanion.title}</strong>
      <span>{visualCompanion.description}</span>
      <span class="bt4k-manual-visual__action">{visualCompanion.label} →</span>
    </span>
  </a>
)}
