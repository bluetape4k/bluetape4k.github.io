---
import { resolveBlogTaxonomy } from '../lib/blogTaxonomy.mjs';

interface Props {
  locale?: 'en' | 'ko';
}

interface BlogPostFrontmatter {
  title: string;
  description?: string;
  blog?: {
    date: string | Date;
    image: string;
    imageAlt: string;
    cardDescription?: string;
    tags?: string[];
  };
}

interface BlogPostModule {
  frontmatter: BlogPostFrontmatter;
}

const { locale = 'en' } = Astro.props;
const basePath = locale === 'ko' ? '/ko/blog/' : '/blog/';
const copy =
  locale === 'ko'
    ? {
        tags: '태그',
        popularTags: '인기 태그',
        allTags: '전체 태그',
        all: '전체',
        count: (value: number) => `${value}개 글`,
        empty: '선택한 태그의 글이 없습니다.',
      }
    : {
        tags: 'Tags',
        popularTags: 'Popular tags',
        allTags: 'All tags',
        all: 'All',
        count: (value: number) => `${value} ${value === 1 ? 'post' : 'posts'}`,
        empty: 'No posts match the selected tag.',
      };

const modules =
  locale === 'ko'
    ? import.meta.glob<BlogPostModule>('../content/docs/ko/blog/*.mdx', { eager: true })
    : import.meta.glob<BlogPostModule>('../content/docs/blog/*.mdx', { eager: true });

const posts = Object.entries(modules)
  .filter(([path, module]) => !path.endsWith('/index.mdx') && module.frontmatter.blog)
  .map(([path, module]) => {
    const slug = path.split('/').pop()?.replace(/\.mdx$/, '') ?? '';
    const href = `${basePath}${slug}/`;
    const blog = module.frontmatter.blog!;
    const description = blog.cardDescription ?? module.frontmatter.description ?? '';
    const taxonomy = resolveBlogTaxonomy(
      {
        slug,
        title: module.frontmatter.title,
        description,
        tags: blog.tags,
      },
      locale,
    );

    return {
      href,
      title: module.frontmatter.title,
      description,
      image: blog.image,
      imageAlt: blog.imageAlt,
      date: new Date(blog.date).getTime(),
      slug,
      taxonomy,
    };
  })
  .sort((left, right) => right.date - left.date || left.slug.localeCompare(right.slug));

const countBy = (values: string[]) =>
  values.reduce<Record<string, number>>((counts, value) => {
    counts[value] = (counts[value] ?? 0) + 1;
    return counts;
  }, {});

const tagCounts = countBy(posts.flatMap((post) => post.taxonomy.tags.map((tag) => String(tag.slug))));
const tagsByPopularity = Object.keys(tagCounts)
  .map((slug) => ({
    slug: String(slug),
    label: String(posts.flatMap((post) => post.taxonomy.tags).find((tag) => tag.slug === slug)?.label ?? slug),
  }))
  .sort((left, right) => tagCounts[right.slug] - tagCounts[left.slug] || left.label.localeCompare(right.label));
const popularTags = tagsByPopularity.slice(0, 12);
const allTags = [...tagsByPopularity].sort((left, right) => left.label.localeCompare(right.label, locale));
const filterHref = (kind: 'tag', value: string) =>
  value === 'all' ? basePath : `${basePath}?${new URLSearchParams({ [kind]: value }).toString()}`;
---

<div class="bt4k-blog-index" data-blog-index data-base-path={basePath} data-locale={locale}>
  <section class="bt4k-blog-taxonomy" aria-label={copy.tags}>
    <div class="bt4k-blog-taxonomy-header">
      <span data-blog-count aria-live="polite" aria-atomic="true">{copy.count(posts.length)}</span>
    </div>
    <div class="bt4k-blog-filter-row" data-blog-filter-row="tag" data-blog-popular-tags>
      <strong>{copy.popularTags}</strong>
      <a href={basePath} data-blog-filter="tag" data-filter-value="all" aria-current="true">{copy.all}</a>
      {
        popularTags.map((tag) => (
          <a href={filterHref('tag', tag.slug)} data-blog-filter="tag" data-filter-value={tag.slug}>
            {tag.label}
            <span>{tagCounts[tag.slug]}</span>
          </a>
        ))
      }
    </div>
    <details class="bt4k-blog-tag-directory" data-blog-tag-directory>
      <summary>{copy.allTags}</summary>
      <div class="bt4k-blog-filter-row" data-blog-filter-row="tag">
        {
          allTags.map((tag) => (
            <a href={filterHref('tag', tag.slug)} data-blog-filter="tag" data-filter-value={tag.slug}>
              {tag.label}
              <span>{tagCounts[tag.slug]}</span>
            </a>
          ))
        }
      </div>
    </details>
  </section>

  <div class="bt4k-blog-list">
    {
      posts.map((post) => (
        <article class="bt4k-blog-card" data-blog-card data-tags={post.taxonomy.tags.map((tag) => tag.slug).join(' ')}>
          <a class="bt4k-blog-card-media" href={post.href}>
            <img src={post.image} alt={post.imageAlt} loading="eager" />
          </a>
          <div class="bt4k-blog-card-body">
            <a class="bt4k-blog-card-title" href={post.href}><strong>{post.title}</strong></a>
            <span class="bt4k-blog-card-description">{post.description}</span>
            <span class="bt4k-blog-card-tags">
              {post.taxonomy.tags.slice(0, 8).map((tag) => (
                <a href={filterHref('tag', tag.slug)} data-blog-filter="tag" data-filter-value={tag.slug}>
                  {tag.label}
                </a>
              ))}
            </span>
          </div>
        </article>
      ))
    }
  </div>
  <p class="bt4k-blog-empty" data-blog-empty hidden>{copy.empty}</p>
</div>

<script is:inline>
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root || !root.matches('[data-blog-index]')) return;

    const basePath = root.dataset.basePath || window.location.pathname;
    const locale = root.dataset.locale || 'en';
    const cards = [...root.querySelectorAll('[data-blog-card]')];
    const links = [...root.querySelectorAll('[data-blog-filter]')];
    const directory = root.querySelector('[data-blog-tag-directory]');
    const popularTags = new Set(
      [...root.querySelectorAll('[data-blog-popular-tags] [data-filter-value]')]
        .map((link) => link.dataset.filterValue)
        .filter((value) => value && value !== 'all'),
    );
    const count = root.querySelector('[data-blog-count]');
    const empty = root.querySelector('[data-blog-empty]');
    const countLabel = (value) => (locale === 'ko' ? `${value}개 글` : `${value} ${value === 1 ? 'post' : 'posts'}`);

    const state = () => {
      const params = new URLSearchParams(window.location.search);
      return {
        tag: params.get('tag') || 'all',
      };
    };

    const render = () => {
      const { tag } = state();
      let visible = 0;

      for (const card of cards) {
        const cardTags = (card.dataset.tags || '').split(' ').filter(Boolean);
        const matches = tag === 'all' || cardTags.includes(tag);
        card.hidden = !matches;
        if (matches) visible += 1;
      }

      for (const link of links) {
        const value = link.dataset.filterValue || 'all';
        if (tag === value) {
          link.setAttribute('aria-current', 'true');
        } else {
          link.removeAttribute('aria-current');
        }
      }

      if (count) count.textContent = countLabel(visible);
      if (empty) empty.hidden = visible !== 0;
      if (directory) directory.open = tag !== 'all' && !popularTags.has(tag);
    };

    root.addEventListener('click', (event) => {
      const link = event.target.closest('[data-blog-filter]');
      if (!link) return;
      event.preventDefault();
      const nextUrl = new URL(link.href);
      const params = new URLSearchParams(nextUrl.search);
      const query = params.toString();
      history.pushState(null, '', query ? `${basePath}?${query}` : basePath);
      render();
    });

    window.addEventListener('popstate', render);
    render();
  })();
</script>
