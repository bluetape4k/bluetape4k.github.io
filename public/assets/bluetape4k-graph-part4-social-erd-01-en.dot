digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "person" [label="Person"];
  "friend" [label="Person"];
  "follow" [label="Person"];
  "company" [label="Company"];
  "person" -> "friend" [label="KNOWS"];
  "friend" -> "company" [label="colleague path"];
  "person" -> "company" [label="WORKS_AT"];
  "person" -> "follow" [label="FOLLOWS"];
}
