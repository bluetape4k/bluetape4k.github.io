digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "graph" [label="GraphOperations"];
  "core" [label="graph-io-core"];
  "formats" [label="Data Format"];
  "uses" [label="운영 활용"];
  "bench" [label="Benchmark Gate"];
  "decorators" [label="I/O Decorator"];
  "graph" -> "core";
  "core" -> "formats";
  "formats" -> "uses";
  "core" -> "bench";
  "formats" -> "decorators";
  "decorators" -> "uses";
}
