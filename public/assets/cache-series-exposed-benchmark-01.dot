digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10, color="#4d7fb8", arrowsize=0.7];

  baseline [label="NO_CACHE\nREAD_HEAVY\n517.5 us/op", fillcolor="#f5f7fb"];
  readThrough [label="READ_THROUGH\nREAD_HEAVY\n94.3 us/op", fillcolor="#e9f7ec"];
  writeThrough [label="WRITE_THROUGH\nREAD_HEAVY\n52.1 us/op", fillcolor="#e8f2ff"];
  writeHeavy [label="WRITE_HEAVY\n445-508 us/op", fillcolor="#fff6df"];
  readHit [label="Read-through hit\n0.003 us/op", fillcolor="#e9f7ec"];
  readMiss [label="Read-through miss\n0.085-0.119 us/op", fillcolor="#fdecef"];

  baseline -> readThrough [label="5.5x faster"];
  baseline -> writeThrough [label="9.9x faster"];
  readThrough -> readHit [label="hot read"];
  readThrough -> readMiss [label="miss reload"];
  writeThrough -> writeHeavy [label="write-heavy effect small"];
}
