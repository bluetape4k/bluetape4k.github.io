digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "apps" [label="앱과 Workshop 예제"];
  "framework" [label="Framework Adapter"];
  "io" [label="Graph I/O"];
  "core" [label="graph-core"];
  "storage" [label="Graph Storage Adapter"];
  "apps" -> "framework";
  "framework" -> "core";
  "io" -> "core";
  "core" -> "storage";
}
