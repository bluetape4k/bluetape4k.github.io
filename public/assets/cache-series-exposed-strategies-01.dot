digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10, color="#4d7fb8", arrowsize=0.7];

  api [label="JdbcCacheRepository\nget / getAll / put / putAll", fillcolor="#e8f2ff"];
  redisson [label="RMap / RLocalCachedMap\nloader + optional writer", fillcolor="#e9f7ec"];
  loader [label="EntityMapLoader\nExposedEntityMapLoader", fillcolor="#edf7ff"];
  writer [label="EntityMapWriter\nExposedEntityMapWriter", fillcolor="#fff6df"];
  db [shape=cylinder, label="Exposed DB\nIdTable", fillcolor="#eef2ff"];

  ro [label="READ_ONLY_WITH_NEAR_CACHE\nUserCredentials", fillcolor="#f5f7fb"];
  wt [label="READ_WRITE_THROUGH_WITH_NEAR_CACHE\nUser", fillcolor="#e8f2ff"];
  wb [label="WRITE_BEHIND_WITH_NEAR_CACHE\nUserEvent", fillcolor="#fdecef"];

  api -> redisson [label="get / put"];
  redisson -> api [label="cache hit"];
  redisson -> loader [label="cache miss"];
  loader -> db [label="read from DB"];
  redisson -> writer [label="put / putAll"];
  writer -> db [label="WRITE_THROUGH now\nWRITE_BEHIND async"];
  ro -> redisson [label="loader only"];
  wt -> redisson [label="loader + writer"];
  wb -> redisson [label="writer queue"];
}
