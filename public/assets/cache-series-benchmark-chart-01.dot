digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=0.5];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [color="#4d7fb8", arrowsize=0.7];

  l1 [label="L1 hit\n~64K ops/ms", fillcolor="#e9f7ec"];
  l2 [label="L2 hit/miss\n~4 ops/ms", fillcolor="#eef2ff"];
  put [label="putSingle\n~2 ops/ms", fillcolor="#fff6df"];
  batch [label="putAll 16KB\n~0.4 ops/ms", fillcolor="#ffe9e4"];
  insight [label="Hot reads belong in L1", fillcolor="#f3efff"];

  l1 -> insight;
  l2 -> insight;
  put -> insight;
  batch -> insight;
}
