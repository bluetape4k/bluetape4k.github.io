digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "document" [label="Document"];
  "entity" [label="Entity"];
  "concept" [label="Concept"];
  "related" [label="Entity"];
  "document" -> "entity" [label="MENTIONS"];
  "entity" -> "concept" [label="IS_A"];
  "entity" -> "related" [label="RELATED_TO"];
}
