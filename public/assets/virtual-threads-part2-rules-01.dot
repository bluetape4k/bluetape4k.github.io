digraph VirtualThreadsRules {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.7, bgcolor="transparent"];
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=12, margin="0.18,0.12"];
  edge [color="#5c7d70", penwidth=2, arrowsize=0.8, fontname="Comic Mono", fontsize=10];

  sync [label="Blocking sync code\nis OK for I/O", fillcolor="#e3f2ec"];
  perTask [label="Thread per task\nnot pooled virtual threads", fillcolor="#eaf4ff"];
  limit [label="Limit resource access\nwith Semaphore", fillcolor="#fff1df"];
  context [label="Prefer ScopedValue\nfor context", fillcolor="#f4f0ff"];
  lock [label="Keep lock scope small\nReentrantLock when needed", fillcolor="#e6f4ff"];

  sync -> perTask;
  perTask -> limit;
  limit -> context;
  context -> lock;
}
