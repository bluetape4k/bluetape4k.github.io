digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  caller [label="Caller"];
  service [label="Audit Service"];
  javers [label="JaVers"];
  repo [label="Snapshot Repo"];
  table [label="ProductTable"];
  caller -> service [label="1. save(author, product)"];
  service -> javers [label="2. commit author and object"];
  javers -> repo [label="3. persist CDO snapshot"];
  service -> table [label="4. upsert current row"];
  caller -> service [label="5. later: history or diff query"];
}
