digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [color="#4d7fb8", arrowsize=0.7];

  controller [label="Spring Service", fillcolor="#e8f2ff"];
  nocache [label="No Cache\nbaseline", fillcolor="#f5f7fb"];
  caffeine [label="Caffeine\nlocal", fillcolor="#e9f7ec"];
  redis [label="Redis\nremote", fillcolor="#ffe9e4"];
  near [label="Near Cache\nlocal + remote", fillcolor="#eefaf7"];
  db [shape=cylinder, label="Product DB", fillcolor="#eef2ff"];
  bench [label="Benchmark\ncompare profiles", fillcolor="#fff6df"];

  controller -> nocache;
  controller -> caffeine;
  controller -> redis;
  controller -> near;
  nocache -> db;
  caffeine -> db;
  redis -> db;
  near -> redis;
  redis -> db;
  nocache -> bench;
  caffeine -> bench;
  redis -> bench;
  near -> bench;
}
