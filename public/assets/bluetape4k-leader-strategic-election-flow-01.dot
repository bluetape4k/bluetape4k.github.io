digraph StrategicElectionFlow {
  graph [rankdir=LR, bgcolor="transparent", nodesep=0.6, ranksep=0.8, splines=ortho]
  node [shape=box, style="rounded,filled", fontname="Comic Mono", fontsize=11, color="#9fb3c8", fillcolor="#ffffff"]
  edge [fontname="Comic Mono", fontsize=10, color="#5a7895", arrowsize=0.8]

  node_a [label="node-a\nCandidateInfo"]
  node_b [label="node-b\nCandidateInfo"]
  node_c [label="node-c\nCandidateInfo"]
  registry [label="candidate registry\nper-node TTL", fillcolor="#eef6ff"]
  list [label="listCandidates()", fillcolor="#f8fafc"]
  strategy [label="ElectionStrategy\nFIFO / Random / Scored", fillcolor="#f5f3ff"]
  winner [label="selected node", fillcolor="#dcfce7"]
  execute [label="run action", fillcolor="#ecfdf5"]
  skipped [label="other nodes\nreturn null", fillcolor="#fff7ed"]
  result [label="updateResult()\nsuccess / failure", fillcolor="#f7fee7"]

  {rank=same; node_a; node_b; node_c}

  node_a -> registry [label="register / refresh"]
  node_b -> registry [label="register / refresh"]
  node_c -> registry [label="register / refresh"]
  registry -> list [label="load candidates"]
  list -> strategy [label="same list"]
  strategy -> winner [label="select one"]
  winner -> execute [label="if nodeId matches"]
  strategy -> skipped [label="if nodeId differs"]
  execute -> result [label="record"]
  result -> registry [label="refresh history"]
}
