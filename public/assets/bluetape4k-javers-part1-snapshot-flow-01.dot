digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  domain [label="Domain Object"];
  commit [label="JaVers Commit"];
  repo [label="Snapshot Repository"];
  query [label="Query & Diff"];
  domain -> commit;
  commit -> repo;
  repo -> query;
}
