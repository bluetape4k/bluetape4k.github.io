digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  manual [label="Manual Audit Table"];
  service [label="Application Service"];
  javers [label="JaVers Snapshot Flow"];
  history [label="Reader"];
  service -> manual;
  service -> javers;
  javers -> history;
}
