digraph G {
  graph [
    rankdir=LR,
    bgcolor="transparent",
    splines=ortho,
    nodesep=0.72,
    ranksep=0.96,
    margin=0.08
  ];

  node [
    shape=box,
    style="rounded,filled",
    penwidth=2,
    color="#6b7280",
    fillcolor="#fffdf7",
    fontname="Architects Daughter",
    fontsize=18,
    margin="0.18,0.12"
  ];

  edge [
    color="#64748b",
    penwidth=2,
    arrowsize=0.8,
    fontname="Comic Mono",
    fontsize=12
  ];

  app [label="Service code"];
  core [label="Core\nrequire / codec / collections"];
  logging [label="Logging\nlazy log + MDC"];
  coroutines [label="Coroutines\nDeferred + Flow"];
  fixtures [label="Test fixtures\nJUnit5 + Testcontainers"];
  proof [label="Deterministic proof\nassertions + cleanup"];

  app -> core [label="validate"];
  core -> logging [label="explain"];
  logging -> coroutines [label="propagate context"];
  coroutines -> fixtures [label="exercise async path"];
  fixtures -> proof [label="verify and reset"];
}
