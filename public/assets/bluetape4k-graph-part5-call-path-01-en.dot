digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "syncCaller" [label="Caller Thread"];
  "syncMethod" [label="Sync Method"];
  "backend" [label="Graph Backend"];
  "vtCaller" [label="Caller Thread"];
  "vtAdapter" [label="Virtual Thread Adapter"];
  "wait" [label="Wait Boundary"];
  "syncCaller" -> "syncMethod";
  "syncMethod" -> "backend";
  "vtCaller" -> "vtAdapter";
  "vtAdapter" -> "backend";
  "backend" -> "wait";
}
