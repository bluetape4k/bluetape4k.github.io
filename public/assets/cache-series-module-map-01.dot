digraph G {
  graph [rankdir=TB, splines=ortho, nodesep=0.55, ranksep=0.65];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [color="#4d7fb8", arrowsize=0.7];

  app [label="Application Code", fillcolor="#e8f2ff"];
  core [label="cache-core\nJCache, SuspendCache,\nNearCache interfaces", fillcolor="#f7fbff"];
  local [label="Local Providers\nCaffeine, Cache2k,\nEhcache", fillcolor="#e9f7ec"];
  memo [label="Memoizers\nsync, async, suspend", fillcolor="#fff6df"];
  resilience [label="Resilience\nretry, fallback,\nstats", fillcolor="#f3efff"];
  lettuce [label="cache-lettuce\nRedis RESP3 NearCache", fillcolor="#eefaf7"];
  redisson [label="cache-redisson\nRLocalCachedMap", fillcolor="#fff0ee"];
  hazelcast [label="cache-hazelcast\nIMap NearCache", fillcolor="#edf7ff"];
  redis [shape=cylinder, label="Redis", fillcolor="#ffe9e4"];
  cluster [shape=cylinder, label="Distributed Store", fillcolor="#f5f7fb"];

  app -> core;
  core -> local;
  core -> memo;
  core -> resilience;
  core -> lettuce;
  core -> redisson;
  core -> hazelcast;
  lettuce -> redis;
  redisson -> redis;
  hazelcast -> cluster;
}
