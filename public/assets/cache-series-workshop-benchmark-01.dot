digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=0.7];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10, color="#4d7fb8", arrowsize=0.7];

  noCache [label="No Cache\nread 8.2k ops/s\nwrite 8.2k ops/s", fillcolor="#f5f7fb"];
  caffeine [label="Caffeine\nread 490k ops/s\nwrite 8.1k ops/s", fillcolor="#e9f7ec"];
  nearCache [label="Near Cache\nread 465k ops/s\nwrite 7.2k ops/s", fillcolor="#e9f7f6"];
  redis [label="Redis Cache\nread 43k ops/s\nwrite 7.3k ops/s", fillcolor="#fdecef"];
  writeThrough [label="Write-Through\nread 41k ops/s\nwrite 5.6k ops/s", fillcolor="#e8f2ff"];
  writeBehind [label="Write-Behind\nread 42k ops/s\nwrite 24k ops/s", fillcolor="#fff6df"];

  noCache -> caffeine [label="60x read"];
  noCache -> nearCache [label="57x read"];
  noCache -> redis [label="5x read"];
  noCache -> writeBehind [label="3x write"];
  writeThrough -> writeBehind [label="async flush tradeoff"];
}
