digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  cmd [label="Command Handler"];
  agg [label="Order Aggregate"];
  store [label="Exposed Store"];
  javers [label="JaVers Audit"];
  event [label="Event Publisher"];
  read [label="Read Model"];
  cmd -> agg;
  agg -> store;
  store -> javers;
  javers -> event;
  event -> read;
}
