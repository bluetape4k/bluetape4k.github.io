digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.6, ranksep=0.75];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, color="#8aa4bd", fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=10, color="#4d7fb8", arrowsize=0.7];

  app [label="Application", fillcolor="#e8f2ff"];
  front [label="L1 Front Cache\nCaffeine", fillcolor="#e9f7ec"];
  back [shape=cylinder, label="L2 Remote Cache\nRedis", fillcolor="#ffe9e4"];
  tracking [label="RESP3 CLIENT TRACKING\nserver push invalidation", fillcolor="#eefaf7"];
  pubsub [label="Pub/Sub invalidation\nclient-managed topic", fillcolor="#fff6df"];

  app -> front [label="get"];
  front -> app [label="hit"];
  front -> back [label="miss -> load"];
  back -> front [label="fill"];
  app -> back [label="write-through"];
  back -> tracking [label="key changed"];
  tracking -> front [label="invalidate"];
  back -> pubsub [label="publish"];
  pubsub -> front [label="invalidate"];
}
