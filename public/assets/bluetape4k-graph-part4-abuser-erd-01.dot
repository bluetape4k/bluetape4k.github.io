digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "user" [label="User"];
  "device" [label="Device"];
  "ip" [label="IpAddress"];
  "phone" [label="PhoneNumber"];
  "payment" [label="PaymentMethod"];
  "referral" [label="User"];
  "user" -> "device" [label="USES_DEVICE"];
  "user" -> "ip" [label="USES_IP"];
  "user" -> "phone" [label="HAS_PHONE"];
  "user" -> "payment" [label="USES_PAYMENT"];
  "user" -> "referral" [label="REFERRED_BY"];
}
