digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "seed" [label="Seed User"];
  "ids" [label="Shared Identifier"];
  "users" [label="Related Users"];
  "paths" [label="Suspicion Evidence"];
  "rank" [label="Risk Ranking"];
  "seed" -> "ids";
  "ids" -> "users";
  "seed" -> "paths";
  "paths" -> "rank";
  "users" -> "rank";
}
