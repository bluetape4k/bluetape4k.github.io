digraph G {
  graph [rankdir=LR, splines=ortho, nodesep=0.7, ranksep=1.0];
  node [shape=box, style=rounded];
  "service" [label="Service"];
  "ops" [label="GraphOperations"];
  "tx" [label="Transaction Scope"];
  "adapter" [label="Storage Adapter"];
  "db" [label="Graph DB"];
  "service" -> "ops" [label="1. transaction { ... }"];
  "ops" -> "tx" [label="2. expose CRUD-only scope"];
  "tx" -> "adapter" [label="3. createVertices batch"];
  "tx" -> "adapter" [label="4. createEdges batch"];
  "adapter" -> "db" [label="5. commit or rollback"];
  "service" -> "ops" [label="6. neighbors / shortestPath"];
}
